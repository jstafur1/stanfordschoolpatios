# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection (PostgreSQL URI from Supabase)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# AI / Chatbot (Optional - NVIDIA NIM)
NVIDIA_API_KEY=your-nvidia-nim-api-key

# Initial Admin Credentials (Optional)
ADMIN_SEED_PASSWORD=your-secure-admin-password
